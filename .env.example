# ============================================================
# APLICAÇÃO
# ============================================================
NODE_ENV=development
PORT=3000

# ============================================================
# FIREBIRD 2.5
# ============================================================

# Endereço do servidor Firebird (IP ou hostname)
FB_HOST=127.0.0.1

# Porta padrão do Firebird (3050)
FB_PORT=3050

# Caminho completo do banco de dados no servidor
# Windows: C:/dados/banco.fdb  ou  C:\\dados\\banco.fdb
# Linux:   /opt/firebird/dados/banco.fdb
FB_DATABASE=/caminho/para/seu/banco.fdb

# Credenciais
FB_USER=SYSDBA
FB_PASSWORD=sua_senha_aqui

# Charset — WIN1252 para bases legadas em português (Windows-1252)
FB_CHARSET=WIN1252

# ============================================================
# POOL DE CONEXÕES
# ============================================================

# Número máximo de conexões simultâneas no pool
FB_POOL_MAX=10

# Tempo (ms) para aguardar uma conexão livre antes de lançar erro
FB_POOL_ACQUIRE_TIMEOUT=10000

# ============================================================
# JWT — AUTENTICAÇÃO
# ============================================================

# Chave secreta para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# Tempo de expiração do token (ex.: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ============================================================
# SWAGGER / DOCUMENTAÇÃO
# ============================================================

# URL base exibida no Swagger UI (ex.: http://localhost:3000)
API_BASE_URL=http://localhost:3000
